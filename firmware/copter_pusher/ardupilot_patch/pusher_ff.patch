@@ -- At the END of AC_AttitudeControl_Multi::rate_controller_run(), insert just before control_monitor_update(); --
     _motors.set_yaw_ff(get_rate_yaw_pid().get_ff() * _feedforward_scalar);

+    // ====================================================================
+    // Pusher (X-axis propulsion) torque feed-forward compensation
+    // ====================================================================
+    // A body +X pusher prop produces, per the torque model:
+    //     F_p   = [T_p, 0, 0]                       (forward thrust)
+    //     tau_p = [ sigma*Q_p , z_p*T_p , -h*T_p ]  (roll, pitch, yaw)
+    // where T_p, Q_p ~ Omega^2 ~ (pusher command)^2.
+    // The main rotors must generate tau_main = tau_des - tau_p, i.e. ADD
+    // -tau_p as feed-forward so the disturbance is cancelled BEFORE an
+    // attitude error develops (instead of the rate loop reacting late and
+    // saturating, as it did in crash 00000170.BIN).
+    // Gains fold in all unknown constants (z_p, h, sigma, kT, kQ) and are
+    // calibrated empirically. Sign is chosen by the user during bring-up.
+    if (_push_en) {
+        float pusher_norm = 0.0f;
+        if (rc().has_valid_input()) {
+            const RC_Channel *pch = rc().channel(constrain_int16(_push_rc, 1, 16) - 1);
+            if (pch != nullptr) {
+                // norm_input_ignore_trim() -> -1..+1 over [min,max]; map idle(min)->0, full(max)->1
+                pusher_norm = (pch->norm_input_ignore_trim() + 1.0f) * 0.5f;
+            }
+        }
+        pusher_norm = constrain_float(pusher_norm, 0.0f, 1.0f);
+        const float p2 = pusher_norm * pusher_norm;     // thrust/torque ~ command^2
+
+        _motors.set_roll (_motors.get_roll()  + _push_rll * p2);
+        _motors.set_pitch(_motors.get_pitch() + _push_pit * p2);
+        _motors.set_yaw  (_motors.get_yaw()   + _push_yaw * p2);
+    }
+
     _sysid_ang_vel_body.zero();
     _actuator_sysid.zero();

     control_monitor_update();
 }
