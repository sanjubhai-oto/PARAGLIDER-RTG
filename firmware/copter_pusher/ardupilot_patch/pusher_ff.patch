@@ -- Member variables (add near the other AP_Param members, e.g. after _thr_mix_man) --
     AP_Float                _thr_mix_man;       // throttle vs attitude control prioritisation used when using manual throttle (higher values mean we prioritise attitude control over throttle)
+
+    // ---- Pusher (X-axis propulsion) torque feed-forward compensation ----
+    // Cancels the disturbance moments produced by a body +X pusher prop:
+    //   pitch  : thrust line vertical offset from CG  (the term that crashed 00000170.BIN)
+    //   roll   : pusher motor reaction torque         (sigma * Q_p)
+    //   yaw    : thrust line Y offset from CG         (-h * T_p)
+    // All gains default to 0 -> identical to stock until calibrated.
+    AP_Int8                 _push_en;           // enable pusher compensation
+    AP_Int8                 _push_rc;           // RC input channel driving the pusher (1..16)
+    AP_Float                _push_pit;          // pitch feed-forward gain (normalised per pusher_norm^2)
+    AP_Float                _push_rll;          // roll  feed-forward gain
+    AP_Float                _push_yaw;          // yaw   feed-forward gain
